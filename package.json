{
  "name": "quote0",
  "version": "1.0.0-alpha.7",
  "description": "TypeScript SDK and CLI for Quote/0.",
  "keywords": [
    "cli",
    "e-ink",
    "quote0"
  ],
  "bugs": {
    "url": "https://github.com/MrWillCom/quote0/issues"
  },
  "license": "MIT",
  "author": "Mr. Will (https://github.com/MrWillCom)",
  "repository": "git+https://github.com/MrWillCom/quote0.git",
  "bin": {
    "quote0": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "openapi-ts": "openapi-ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset"
  },
  "dependencies": {
    "@kud/ink-ui": "^0.29.0",
    "cac": "^7.0.0",
    "conf": "^15.1.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.68.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
